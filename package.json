{
	"name": "@monarcode/session-kit",
	"version": "0.1.0-alpha.7",
	"description": "Schema-driven sessions for React, with TanStack Router, React Router, and Expo Router support, and server rendering with TanStack Start, Next.js, and React Router",
	"keywords": [
		"auth",
		"effect",
		"effetch",
		"expo",
		"expo-router",
		"nextjs",
		"react",
		"react-native",
		"react-router",
		"router",
		"ssr",
		"standard-schema",
		"tanstack",
		"tanstack-start"
	],
	"homepage": "https://github.com/monarcode/session-kit#readme",
	"bugs": {
		"url": "https://github.com/monarcode/session-kit/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/monarcode/session-kit.git"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		},
		"./tanstack-router": {
			"types": "./dist/tanstack-router/index.d.ts",
			"import": "./dist/tanstack-router/index.js"
		},
		"./react-router": {
			"types": "./dist/react-router/index.d.ts",
			"import": "./dist/react-router/index.js"
		},
		"./react-router/server": {
			"types": "./dist/react-router/server.d.ts",
			"import": "./dist/react-router/server.js"
		},
		"./http": {
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./tanstack-start": {
			"types": "./dist/tanstack-start/index.d.ts",
			"import": "./dist/tanstack-start/index.js"
		},
		"./tanstack-start/server": {
			"types": "./dist/tanstack-start/server.d.ts",
			"import": "./dist/tanstack-start/server.js"
		},
		"./next": {
			"types": "./dist/next/index.d.ts",
			"import": "./dist/next/index.js"
		},
		"./expo": {
			"types": "./dist/expo/index.d.ts",
			"import": "./dist/expo/index.js"
		},
		"./effect": {
			"types": "./dist/effect/index.d.ts",
			"import": "./dist/effect/index.js"
		},
		"./effetch": {
			"types": "./dist/effetch/index.d.ts",
			"import": "./dist/effetch/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepare": "husky",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"clean": "node scripts/clean.mjs",
		"build": "pnpm run clean && tsc -p tsconfig.json",
		"build:examples": "pnpm run build && pnpm --filter \"./examples/*\" run build",
		"dev": "tsc -p tsconfig.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm run test:sync && pnpm run test:async",
		"test:sync": "node --conditions=development --test tests/*.test.ts",
		"test:async": "node --env-file=tests/async-storage.env --conditions=development --test tests/*.test.ts",
		"test:types": "tsc -p tests/tsconfig.tests.json && tsc -p tests/tsconfig.json && tsc -p tests/tsconfig.bundler.json && tsc -p tests/tsconfig.json --exactOptionalPropertyTypes false && tsc -p tests/tsconfig.mirror.json && tsc -p tests/tsconfig.mirror.bundler.json && tsc -p tests/tsconfig.mirror.json --exactOptionalPropertyTypes false && pnpm run test:docs",
		"test:docs": "node scripts/check-docs.mjs",
		"check": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm test && pnpm run test:types",
		"prepack": "pnpm run check"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0",
		"nanostores": "^1.5.5",
		"use-sync-external-store": "^1.6.0"
	},
	"devDependencies": {
		"@monarcode/effetch": "0.1.0-rc.2",
		"@monarcode/effetch-query": "0.1.0-rc.2",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"@types/jsdom": "21.1.7",
		"@types/node": "22.20.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/use-sync-external-store": "1.7.0",
		"axios": "1.21.1",
		"effect": "4.1.3",
		"expo-file-system": "58.0.13",
		"expo-router": "58.0.30",
		"expo-secure-store": "58.0.2",
		"husky": "9.1.7",
		"jsdom": "26.1.0",
		"ky": "2.2.0",
		"next": "16.4.6",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-native": "0.88.1",
		"react-router": "8.5.1",
		"typescript": "6.0.3",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@monarcode/effetch": "^0.1.0-rc.2",
		"@tanstack/react-router": "^1.132.0",
		"@tanstack/react-start": "^1.169.0",
		"effect": "^4.1.0",
		"expo-file-system": "^18.1.0 || ^19.0.0 || ^55.0.0 || ^56.0.0 || ^57.0.0 || ^58.0.0",
		"expo-router": "^5.0.2 || ^6.0.0 || ^55.0.0 || ^56.0.0 || ^57.0.0 || ^58.0.0",
		"expo-secure-store": "^14.2.0 || ^15.0.0 || ^55.0.0 || ^56.0.0 || ^57.0.0 || ^58.0.0",
		"next": "^16.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-native": ">=0.79.0",
		"react-router": "^7.0.0 || ^8.0.0"
	},
	"peerDependenciesMeta": {
		"@monarcode/effetch": {
			"optional": true
		},
		"@tanstack/react-router": {
			"optional": true
		},
		"@tanstack/react-start": {
			"optional": true
		},
		"effect": {
			"optional": true
		},
		"expo-file-system": {
			"optional": true
		},
		"expo-router": {
			"optional": true
		},
		"expo-secure-store": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-native": {
			"optional": true
		},
		"react-router": {
			"optional": true
		}
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@10.12.1"
}
