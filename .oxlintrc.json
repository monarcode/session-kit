{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"react",
		"import",
		"jsx-a11y",
		"promise",
		"typescript",
		"unicorn"
	],
	"env": {
		"browser": true,
		"node": true,
		"es2025": true
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/build/**",
		"**/.netlify/**",
		"**/routeTree.gen.ts",
		"**/*.gen.ts",
		"**/coverage/**",
		"**/templates/**"
	],
	"rules": {
		"no-unused-vars": "off",
		"typescript/no-unused-vars": [
			"warn",
			{
				"fix": {
					"imports": "safe-fix"
				}
			}
		],
		"import/no-cycle": "error",
		"react/exhaustive-deps": "warn",
		"jsx_a11y/anchor-is-valid": "off",
		"jsx_a11y/click-events-have-key-events": "warn",
		"jsx_a11y/label-has-associated-control": "warn",
		"jsx_a11y/no-static-element-interactions": "warn",
		"jsx_a11y/prefer-tag-over-role": "off"
	}
}
