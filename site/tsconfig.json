{
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "dist", ".output", ".source", "versions"],
	"compilerOptions": {
		"strict": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["vite/client"],
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"target": "ES2022",
		"forceConsistentCasingInFileNames": true,
		"paths": { "@/*": ["./src/*"] },
		"noEmit": true
	}
}
