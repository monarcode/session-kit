{
	"name": "session-kit-example-expo-router",
	"private": true,
	"description": "session-kit with Expo Router on iOS and Android, against DummyJSON's auth API",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"build": "tsc --noEmit && expo export --platform ios --platform android"
	},
	"dependencies": {
		"@monarcode/session-kit": "workspace:*",
		"expo": "58.0.23",
		"expo-constants": "58.0.15",
		"expo-file-system": "58.0.13",
		"expo-linking": "58.0.16",
		"expo-router": "58.0.30",
		"expo-secure-store": "58.0.2",
		"expo-splash-screen": "58.0.13",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-safe-area-context": "5.11.1",
		"react-native-screens": "4.30.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"typescript": "6.0.3"
	}
}
