{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"rootDirs": [".", "./.react-router/types"],
		"types": ["vite/client"]
	},
	"include": ["app", "*.ts", ".react-router/types/**/*"]
}
