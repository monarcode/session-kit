{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"inlineSources": true,
		"removeComments": false,
		"rootDir": "src",
		"outDir": "dist",
		"noEmitOnError": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "tests", "examples", "node_modules"]
}
